POSTGRES_DB=gaming_source
POSTGRES_USER=gaming
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gaming:change-this-local-password@localhost:5432/gaming_source
ANALYTICS_DB=gaming_analytics
ANALYTICS_PORT=5433
RAWG_API_KEY=
RAWG_MAX_PAGES=5
DASHBOARD_PORT=8501
# Read-only dashboard login (created by sql/006_access_roles.sql; Gold schema only)
DASHBOARD_DB_USER=dashboard_user
DASHBOARD_DB_PASSWORD=change-this-dashboard-password
AIRFLOW_PORT=8080
AIRFLOW_UID=50000
AIRFLOW__API_AUTH__JWT_SECRET=
OPENMETADATA_PORT=8585
OPENMETADATA_MYSQL_ROOT_PASSWORD=change-this-openmetadata-root-password
OPENMETADATA_JWT_TOKEN=
DATA_QUALITY_VOLUME_CHANGE_WARN_PERCENT=50
DATA_QUALITY_FRESHNESS_WARN_HOURS=48
DATA_QUALITY_FRESHNESS_ERROR_HOURS=168
DATA_QUALITY_EXCEL_FRESHNESS_WARN_HOURS=720
DATA_QUALITY_EXCEL_FRESHNESS_ERROR_HOURS=1440
AIRFLOW__SMTP__SMTP_HOST=
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_USER=
AIRFLOW__SMTP__SMTP_PASSWORD=
AIRFLOW__SMTP__SMTP_MAIL_FROM=
AIRFLOW__SMTP__SMTP_STARTTLS=true
AIRFLOW__SMTP__SMTP_SSL=false
# Set to false to skip the Airflow email report even when SMTP is configured
QUALITY_EMAIL_ENABLED=true
QUALITY_ALERT_EMAIL_TO=
# Name shown in alert subjects and the business day used for "once per day" alerts
ALERT_NAME=gaming-analytics-capstone
ALERT_TIMEZONE=Asia/Ulaanbaatar
